<Page x:Class="Desktop.Views.IncidenciasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Incidencias" Background="#F0F2F5">
    <Grid Background="#F0F2F5" Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Incidencias" FontSize="24" FontWeight="Bold" Foreground="#161D35"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtTotal" Text="" Foreground="#9AA3B0" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Filter / toolbar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Border.Effect><DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Estado:" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#374151" FontSize="13" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbFiltro" Width="150" Height="30"
                          SelectionChanged="CmbFiltro_SelectionChanged">
                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                    <ComboBoxItem Content="Abierta"/>
                    <ComboBoxItem Content="EnProceso"/>
                    <ComboBoxItem Content="Resuelta"/>
                    <ComboBoxItem Content="Cerrada"/>
                </ComboBox>

                <Button Content="Actualizar" Margin="10,0,0,0" Padding="12,5" FontSize="12"
                        Style="{StaticResource SecondaryBtn}"
                        Click="BtnRefresh_Click"/>

                <Button x:Name="BtnMisIncidencias" Content="Mis incidencias"
                        Margin="8,0,0,0" Padding="10,5" FontSize="12"
                        Style="{StaticResource SecondaryBtn}"
                        Click="BtnMisIncidencias_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnSinAsignar" Content="Sin asignar"
                        Margin="6,0,0,0" Padding="10,5" FontSize="12"
                        Style="{StaticResource SecondaryBtn}"
                        Click="BtnSinAsignar_Click"
                        Visibility="Collapsed"/>

                <!-- Pagination -->
                <Button x:Name="BtnAnterior" Content="◀" Margin="16,0,4,0" Padding="10,5"
                        FontSize="12" Style="{StaticResource SecondaryBtn}"
                        Click="BtnAnterior_Click" IsEnabled="False"/>
                <TextBlock x:Name="TxtPagina" Text="Pág 1 / 1"
                           VerticalAlignment="Center" Margin="6,0" FontSize="13"
                           Foreground="#6C757D"/>
                <Button x:Name="BtnSiguiente" Content="▶" Margin="4,0,0,0" Padding="10,5"
                        FontSize="12" Style="{StaticResource SecondaryBtn}"
                        Click="BtnSiguiente_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- Data table -->
        <Border Grid.Row="2" Background="White" CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
            <DataGrid x:Name="DgIncidencias"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      RowBackground="White" AlternatingRowBackground="#F8FAFF"
                      BorderThickness="0" RowHeight="42" ColumnHeaderHeight="42"
                      MouseDoubleClick="DgIncidencias_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#161D35"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DDEAFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="52">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Foreground" Value="#161D35"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Estado -->
                    <DataGridTemplateColumn Header="Estado" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,3" Margin="8,9"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#6C757D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Abierta">
                                                    <Setter Property="Background" Value="#198754"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="EnProceso">
                                                    <Setter Property="Background" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="Resuelta">
                                                    <Setter Property="Background" Value="#0DCAF0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="EnProceso">
                                                        <Setter Property="Foreground" Value="#212529"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Prioridad -->
                    <DataGridTemplateColumn Header="Prioridad" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,3" Margin="8,9"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ADB5BD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Prioridad}" Value="Critica">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Prioridad}" Value="Alta">
                                                    <Setter Property="Background" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Prioridad}" Value="Media">
                                                    <Setter Property="Background" Value="#0D6EFD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Prioridad}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Prioridad}" Value="Alta">
                                                        <Setter Property="Foreground" Value="#212529"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Categoría -->
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Foreground" Value="#0D9AA0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- SLA badge -->
                    <DataGridTemplateColumn Header="SLA" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,3" Margin="8,9" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SlaExcedido}" Value="True">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="SLA !" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Técnico asignado -->
                    <DataGridTextColumn Header="Técnico" Binding="{Binding TecnicoNombre}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Foreground" Value="#6C757D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Fecha -->
                    <DataGridTextColumn Header="Fecha" Width="140"
                                        Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Foreground" Value="#9AA3B0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>