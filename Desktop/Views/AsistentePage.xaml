<Page x:Class="Desktop.Views.AsistentePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Asistente IA" Background="#F0F2F5">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="46" Height="46" CornerRadius="11" Background="#0D6EFD" Margin="0,0,12,0">
                <TextBlock Text="IA" FontSize="16" FontWeight="Black" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Asistente de Consultas" FontSize="20" FontWeight="Bold" Foreground="#161D35"/>
                <TextBlock Text="Haz clic en una pregunta o escribe la tuya" FontSize="12" Foreground="#8994B3"/>
            </StackPanel>
        </StackPanel>

        <!-- Main split: chat left, questions right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Chat area -->
            <Border Grid.Column="0" Background="White" CornerRadius="10">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" x:Name="ScrollChat" VerticalScrollBarVisibility="Auto" Padding="18,16">
                        <StackPanel x:Name="PanelChat">
                            <TextBlock x:Name="TxtPlaceholder"
                                       Text="Selecciona una pregunta de la derecha o escribe la tuya abajo"
                                       Foreground="#9AA3B0" FontSize="14" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,60,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Free text input -->
                    <Border Grid.Row="1" BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtPreguntaLibre"
                                     Height="36" Padding="10,8" FontSize="13"
                                     BorderBrush="#E5E7EB" BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtPreguntaLibre_KeyDown"/>
                            <Button Grid.Column="1" Content="Enviar" Margin="8,0,0,0"
                                    Padding="14,8" FontSize="13" Background="#0D6EFD" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BtnEnviarLibre_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Question panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,14">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="2"/></Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Técnicos -->
                        <Border Background="#161D35" CornerRadius="4" Padding="8,3" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <TextBlock Text="TÉCNICOS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Button Content="¿Técnico con más activas?" Tag="tecnico-mas-activas"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>
                        <Button Content="¿Técnico con más resueltas?" Tag="tecnico-mas-resueltas"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>

                        <!-- Incidencias -->
                        <Border Background="#198754" CornerRadius="4" Padding="8,3" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <TextBlock Text="INCIDENCIAS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Button Content="¿Categoría con más incidencias?" Tag="categoria-mas-incidencias"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>
                        <Button Content="¿Incidencias sin asignar?" Tag="sin-asignar"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>
                        <Button Content="¿Resumen de estados?" Tag="resumen-estados"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>

                        <!-- SLA -->
                        <Border Background="#DC3545" CornerRadius="4" Padding="8,3" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <TextBlock Text="SLA Y TIEMPOS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Button Content="¿SLA excedido?" Tag="sla-excedido"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>
                        <Button Content="¿Tiempo medio de resolución?" Tag="tiempo-medio"
                                Style="{StaticResource SecondaryBtn}" Padding="10,7" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch" Click="BtnPreguntaFija_Click"/>

                        <!-- Limpiar -->
                        <Separator Background="#F0F2F5" Margin="0,4,0,10"/>
                        <Button Content="Limpiar conversación" Foreground="#9AA3B0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="12" Cursor="Hand" HorizontalAlignment="Left"
                                Click="BtnLimpiar_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
