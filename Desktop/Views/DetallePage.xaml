<Page x:Class="Desktop.Views.DetallePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Detalle" Background="#F0F0F0">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#212529" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Volver" Cursor="Hand" Click="BtnVolver_Click"
                            Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Red"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="10,5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="Gestión de Incidencias" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtTitulo" Foreground="#AAAAAA" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Info incidencia -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="20,15,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Info izquierda -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock x:Name="TxtTituloDetalle" FontSize="18" FontWeight="Bold"
                               Foreground="#1F3864" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtDescripcion" TextWrapping="Wrap" FontSize="13"
                               Foreground="#555" Margin="0,0,0,14"/>

                    <!-- Badges estado y prioridad -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border x:Name="BadgeEstado" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtEstado" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BadgePrioridad" CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="TxtPrioridad" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Técnico asignado: " FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtTecnico" FontSize="13" Foreground="#555"/>
                    </StackPanel>
                </StackPanel>

                <!-- Acciones derecha -->
                <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Cambiar estado" FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbEstado" Margin="0,0,0,8" Height="32">
                            <ComboBoxItem Content="Abierta"/>
                            <ComboBoxItem Content="EnProceso"/>
                            <ComboBoxItem Content="Resuelta"/>
                            <ComboBoxItem Content="Cerrada"/>
                        </ComboBox>
                        <Button Content="Actualizar estado" Click="BtnActualizarEstado_Click"
                                Margin="0,0,0,12" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#0D6EFD"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="10,8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Solo Técnico -->
                        <Button x:Name="BtnAsignar" Content="Asignarme esta incidencia"
                                Click="BtnAsignar_Click" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFC107"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="10,8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Solo Admin -->
                        <TextBlock x:Name="TxtLabelTecnicos" Text="Asignar técnico:"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,6" Visibility="Collapsed"/>
                        <ComboBox x:Name="CmbTecnicos" DisplayMemberPath="Nombre"
                                  Height="32" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <Button x:Name="BtnAsignarTecnico" Content="Asignar técnico"
                                Click="BtnAsignarTecnico_Click" Cursor="Hand"
                                Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFC107"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="10,8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Comentarios + Historial -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Comentarios -->
            <Border Grid.Column="0" Background="White" CornerRadius="6"
                    Margin="0,0,10,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#212529" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,12">
                        <TextBlock Text="Comentarios" Foreground="White"
                                   FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LstComentarios" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" CornerRadius="4"
                                        Padding="10,8" Margin="0,0,0,6"
                                        BorderBrush="#DEE2E6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}"
                                                   FontSize="11" Foreground="#6C757D" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Contenido}"
                                                   TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBox x:Name="TxtComentario" Height="60" Padding="8"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderBrush="#DEE2E6" BorderThickness="1"/>
                        <Button Content="Añadir comentario" Click="BtnComentario_Click"
                                Margin="0,6,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#0D6EFD"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="10,8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Historial -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#212529" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,12">
                        <TextBlock Text="Historial de estados" Foreground="White"
                                   FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LstHistorial" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,6" Margin="0,0,0,4"
                                        BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FechaCambio, StringFormat=dd/MM/yyyy HH:mm}"
                                                   FontSize="11" Foreground="#6C757D" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#6C757D" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding EstadoAnterior}"
                                                           Foreground="White" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text=" → " VerticalAlignment="Center"
                                                       Foreground="#6C757D" Margin="4,0"/>
                                            <Border Background="#0D6EFD" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding EstadoNuevo}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>