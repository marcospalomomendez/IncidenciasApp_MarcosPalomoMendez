<Page x:Class="Desktop.Views.DetallePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Detalle" Background="#F0F2F5">
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title + back button -->
        <Grid Grid.Row="0" Margin="24,20,24,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x2190; Volver" Style="{StaticResource SecondaryBtn}"
                        Padding="12,7" FontSize="13" Margin="0,0,18,0"
                        Click="BtnVolver_Click"/>
                <TextBlock x:Name="TxtPageTitle" Text="Detalle de incidencia"
                           FontSize="22" FontWeight="Bold" Foreground="#161D35"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Incident info card -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Margin="24,0,24,14" Padding="22,18">
            <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="2"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Left: info -->
                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                    <TextBlock x:Name="TxtTituloDetalle" FontSize="19" FontWeight="Bold"
                               Foreground="#161D35" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDescripcion" TextWrapping="Wrap" FontSize="13"
                               Foreground="#4B5563" Margin="0,0,0,16" LineHeight="20"/>

                    <!-- Badges row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border x:Name="BadgeEstado" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtEstado" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BadgePrioridad" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtPrioridad" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BadgeCategoria" CornerRadius="5" Padding="10,4" Margin="0,0,8,0"
                                Background="#0DCAF0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtCategoria" FontSize="12" FontWeight="SemiBold" Foreground="#212529"/>
                        </Border>
                        <Border x:Name="BadgeSla" CornerRadius="5" Padding="10,4"
                                Background="#DC3545" Visibility="Collapsed">
                            <TextBlock Text="SLA !" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Técnico asignado: " FontWeight="SemiBold" FontSize="13"
                                   Foreground="#374151"/>
                        <TextBlock x:Name="TxtTecnico" FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: actions panel -->
                <Border Grid.Column="1" Background="#F8FAFF" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Cambiar estado" FontWeight="Bold" FontSize="13"
                                   Foreground="#374151" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbEstado" Margin="0,0,0,10" Height="33">
                            <ComboBoxItem Content="Abierta"/>
                            <ComboBoxItem Content="EnProceso"/>
                            <ComboBoxItem Content="Resuelta"/>
                            <ComboBoxItem Content="Cerrada"/>
                        </ComboBox>
                        <Button Content="Actualizar estado" Style="{StaticResource PrimaryBtn}"
                                Padding="10,8" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch"
                                Click="BtnActualizarEstado_Click"/>

                        <!-- Técnico: asignarse -->
                        <Button x:Name="BtnAsignar" Content="Asignarme esta incidencia"
                                Style="{StaticResource WarningBtn}"
                                Padding="10,8" Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Click="BtnAsignar_Click"/>

                        <!-- Admin: asignar técnico -->
                        <TextBlock x:Name="TxtLabelTecnicos" Text="Asignar técnico:"
                                   FontWeight="Bold" FontSize="13" Foreground="#374151"
                                   Margin="0,0,0,6" Visibility="Collapsed"/>
                        <ComboBox x:Name="CmbTecnicos" DisplayMemberPath="Nombre"
                                  Height="33" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <Button x:Name="BtnAsignarTecnico" Content="Asignar técnico"
                                Style="{StaticResource WarningBtn}"
                                Padding="10,8" HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                Click="BtnAsignarTecnico_Click"/>

                        <!-- Suscripción -->
                        <Separator Margin="0,12,0,12" Background="#E5E7EB"/>
                        <Button x:Name="BtnSuscribir"
                                Padding="10,8" HorizontalAlignment="Stretch"
                                Click="BtnSuscribir_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Comments + History -->
        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Comments -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18,16">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Comentarios" FontSize="14" FontWeight="Bold"
                               Foreground="#161D35" Margin="0,0,0,14"/>

                    <ListBox Grid.Row="1" x:Name="LstComentarios" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFF" CornerRadius="6"
                                        Padding="12,10" Margin="0,0,0,8"
                                        BorderBrush="#E8EEF8" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}"
                                                   FontSize="11" Foreground="#9AA3B0" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Contenido}"
                                                   TextWrapping="Wrap" FontSize="13" Foreground="#374151"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBox x:Name="TxtComentario" Height="64" Padding="10,8"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderBrush="#E5E7EB" BorderThickness="1"
                                 FontSize="13"/>
                        <Button Content="Añadir comentario" Style="{StaticResource PrimaryBtn}"
                                Padding="10,8" Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Click="BtnComentario_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Auditoría -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18,16">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Auditoría" FontSize="14" FontWeight="Bold"
                               Foreground="#161D35" Margin="0,0,0,14"/>

                    <ListBox Grid.Row="1" x:Name="LstAuditoria" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding IconColor}">
                                        <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Descripcion}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#1F2937"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MetaLinea}" FontSize="10"
                                                   Foreground="#9AA3B0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>