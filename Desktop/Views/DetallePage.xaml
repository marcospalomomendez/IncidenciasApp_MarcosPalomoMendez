<Page x:Class="Desktop.Views.DetallePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Detalle" Background="#F0F0F0">
    <Grid Margin="20" Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Botón volver -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="← Volver" Padding="10,5" BorderThickness="0"
                    Background="#1F3864" Foreground="White" Cursor="Hand"
                    Click="BtnVolver_Click"/>
            <TextBlock x:Name="TxtTitulo" FontSize="18" FontWeight="Bold"
                       Foreground="#1F3864" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Info incidencia -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="16" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtDescripcion" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Estado: " FontWeight="Bold"/>
                        <TextBlock x:Name="TxtEstado" Foreground="#1F3864" FontWeight="SemiBold"/>
                        <TextBlock Text="     Prioridad: " FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPrioridad" Foreground="#C55A11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Técnico: " FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTecnico"/>
                    </StackPanel>
                </StackPanel>

                <!-- Acciones -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Cambiar estado:" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbEstado" Margin="0,0,0,8">
                        <ComboBoxItem Content="Abierta"/>
                        <ComboBoxItem Content="EnProceso"/>
                        <ComboBoxItem Content="Resuelta"/>
                        <ComboBoxItem Content="Cerrada"/>
                    </ComboBox>
                    <Button Content="Actualizar estado" Padding="10,8" BorderThickness="0"
                            Background="#1F3864" Foreground="White" Cursor="Hand"
                            Click="BtnActualizarEstado_Click" Margin="0,0,0,10"/>

                    <!-- Solo Técnico -->
                    <Button x:Name="BtnAsignar" Content="Asignarme esta incidencia"
                            Padding="10,8" BorderThickness="0"
                            Background="#2E7D32" Foreground="White" Cursor="Hand"
                            Click="BtnAsignar_Click" Margin="0,0,0,10"/>

                    <!-- Solo Admin -->
                    <TextBlock x:Name="TxtLabelTecnicos" Text="Asignar técnico:"
                               FontWeight="Bold" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbTecnicos" Margin="0,0,0,8"
                              DisplayMemberPath="Nombre" Visibility="Collapsed"/>
                    <Button x:Name="BtnAsignarTecnico" Content="Asignar técnico"
                            Padding="10,8" BorderThickness="0"
                            Background="#E65100" Foreground="White" Cursor="Hand"
                            Click="BtnAsignarTecnico_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Comentarios -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Comentarios" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="LstComentarios" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}"
                                                   FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Contenido}" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBox x:Name="TxtComentario" Height="60" Padding="8"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderBrush="#CCCCCC" BorderThickness="1"/>
                        <Button Content="Añadir comentario" Margin="0,6,0,0" Padding="10,8"
                                Background="#C55A11" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnComentario_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Historial -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Historial de estados" FontSize="15"
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="LstHistorial" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding FechaCambio, StringFormat=dd/MM/yyyy HH:mm}"
                                               FontSize="11" Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EstadoAnterior}" Foreground="#888"/>
                                        <TextBlock Text=" → " Foreground="#888"/>
                                        <TextBlock Text="{Binding EstadoNuevo}" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>