@page
@model Web.Pages.Tecnico.IndexModel
@{
    ViewData["Title"] = "Panel Técnico";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Panel Técnico</h2>
        <span class="text-muted">@Model.Total incidencias</span>
    </div>

    <!-- Filtros -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        @foreach (var f in new[] { "Todas", "Abierta", "EnProceso", "Resuelta", "Cerrada", "SinAsignar" })
        {
            <a href="?filtro=@f&pagina=1"
               class="btn btn-sm @(Model.FiltroActual == f ? "btn-dark" : "btn-outline-secondary")">
                @(f == "SinAsignar" ? "Sin asignar" : f == "EnProceso" ? "En Proceso" : f)
            </a>
        }
    </div>

    @if (!Model.Incidencias.Any())
    {
        <div class="alert alert-info">No hay incidencias con este filtro.</div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                    <th>Técnico asignado</th>
                    <th>Fecha</th>
                    <th>Detalle</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Incidencias)
                {
                    <tr>
                        <td>@i.Id</td>
                        <td>@i.Titulo</td>
                        <td>
                            <span class="badge
                                        @(i.Estado == "Abierta" ? "bg-success" :
                                                                    i.Estado == "EnProceso" ? "bg-warning text-dark" :
                                                                    i.Estado == "Resuelta" ? "bg-info" : "bg-secondary")">
                                                                                                                      @i.Estado
                                                                                                                  </span>
                                                                                                              </td>
                                                                                                              <td>
                                                                                                                  <span class="badge
                                        @(i.Prioridad == "Critica" ? "bg-danger" :
                                                                    i.Prioridad == "Alta" ? "bg-warning text-dark" :
                                                                    i.Prioridad == "Media" ? "bg-primary" : "bg-secondary")">
                        @i.Prioridad
                    </span>
                </td>
                <td>@(i.TecnicoAsignadoId.HasValue ? "Asignada" : "Sin asignar")</td>
                <td>@i.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td><a href="/Tecnico/Detalle/@i.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a></td>
                <td class="align-middle" style="white-space:nowrap">
                    <form method="post" style="display:inline-flex; align-items:center; gap:4px">
                        <input type="hidden" name="id" value="@i.Id" />
                        <select name="nuevoEstado" class="form-select form-select-sm" style="width:120px">
                            <option value="Abierta"   selected="@(i.Estado == "Abierta"   ? "selected" : null)">Abierta</option>
                            <option value="EnProceso" selected="@(i.Estado == "EnProceso" ? "selected" : null)">En Proceso</option>
                            <option value="Resuelta"  selected="@(i.Estado == "Resuelta"  ? "selected" : null)">Resuelta</option>
                            <option value="Cerrada"   selected="@(i.Estado == "Cerrada"   ? "selected" : null)">Cerrada</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
                    </form>
                </td>
            </tr>
                        }
            </tbody>
        </table>

        <!-- Paginación -->
        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @if (Model.PaginaActual > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?filtro=@Model.FiltroActual&pagina=@(Model.PaginaActual - 1)">← Anterior</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" href="?filtro=@Model.FiltroActual&pagina=@i">@i</a>
                        </li>
                    }
                    @if (Model.PaginaActual < Model.TotalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?filtro=@Model.FiltroActual&pagina=@(Model.PaginaActual + 1)">Siguiente →</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>