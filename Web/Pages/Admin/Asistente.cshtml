@page
@model Web.Pages.Admin.AsistenteModel
@{
    ViewData["Title"] = "Asistente";
}

<div style="max-width:860px;margin:0 auto;padding:28px 20px">

    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:52px;height:52px;background:#0D6EFD;border-radius:14px;
                    display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0">🤖</div>
        <div>
            <h4 class="mb-0" style="color:#161D35;font-weight:700">Asistente de Consultas</h4>
            <span class="text-muted" style="font-size:13px">Haz clic en una pregunta para obtener información en tiempo real</span>
        </div>
    </div>

    <!-- Chat area -->
    <div id="chatArea" style="min-height:180px;max-height:440px;overflow-y:auto;
                               background:white;border-radius:14px;padding:20px 24px;
                               box-shadow:0 1px 4px rgba(0,0,0,.08);margin-bottom:20px;
                               display:flex;flex-direction:column;gap:12px">
        @if (!Model.Historial.Any())
        {
            <div class="text-center text-muted" style="margin:auto;font-size:14px;padding:40px 0">
                <div style="font-size:48px;margin-bottom:10px;opacity:.35">💬</div>
                <div>Selecciona una pregunta de abajo para empezar</div>
            </div>
        }
        @foreach (var (pregunta, respuesta) in Model.Historial)
        {
            <!-- User bubble -->
            <div class="d-flex justify-content-end">
                <div style="background:#0D6EFD;color:white;border-radius:16px 16px 4px 16px;
                            padding:10px 15px;max-width:72%;font-size:14px;line-height:1.4">
                    @pregunta
                </div>
            </div>
            <!-- Bot bubble -->
            <div class="d-flex align-items-start gap-2">
                <div style="width:34px;height:34px;background:#F0F2F5;border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            font-size:17px;flex-shrink:0;margin-top:2px">🤖</div>
                <div style="background:#F0F2F5;border-radius:4px 16px 16px 16px;
                            padding:10px 15px;max-width:76%;font-size:14px;line-height:1.6;color:#1a1a2e">
                    @Html.Raw(Model.FormatearRespuesta(respuesta))
                </div>
            </div>
        }
    </div>

    <!-- Question panel -->
    <div class="card" style="border:none;box-shadow:0 1px 4px rgba(0,0,0,.08);border-radius:14px">
        <div class="card-body p-4">
            <div class="text-muted mb-3" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px">
                Preguntas disponibles
            </div>

            <!-- Técnicos -->
            <div class="mb-3">
                <span class="badge mb-2" style="background:#161D35;font-size:11px">👨‍💻 Técnicos</span>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post">
                        <input type="hidden" name="tipo" value="tecnico-mas-activas" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            ¿Técnico con más incidencias activas?
                        </button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="tipo" value="tecnico-mas-resueltas" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            ¿Técnico con más resueltas en total?
                        </button>
                    </form>
                    <form method="post" class="d-flex gap-1 align-items-center flex-wrap">
                        <input type="hidden" name="tipo" value="tecnico-mas-resueltas-categoria" />
                        <select name="categoria" class="form-select form-select-sm" style="width:120px">
                            <option value="Hardware">Hardware</option>
                            <option value="Software">Software</option>
                            <option value="Red">Red</option>
                            <option value="Acceso">Acceso</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            ¿Técnico más resueltas por categoría?
                        </button>
                    </form>
                </div>
            </div>

            <!-- Incidencias -->
            <div class="mb-3">
                <span class="badge mb-2" style="background:#198754;font-size:11px">📋 Incidencias</span>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post">
                        <input type="hidden" name="tipo" value="categoria-mas-incidencias" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            ¿Categoría con más incidencias?
                        </button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="tipo" value="sin-asignar" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            ¿Incidencias sin asignar?
                        </button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="tipo" value="resumen-estados" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            ¿Resumen actual de estados?
                        </button>
                    </form>
                </div>
            </div>

            <!-- SLA y tiempos -->
            <div class="mb-3">
                <span class="badge mb-2" style="background:#DC3545;font-size:11px">⏱ SLA y Tiempos</span>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post">
                        <input type="hidden" name="tipo" value="sla-excedido" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            ¿Qué incidencias tienen el SLA excedido?
                        </button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="tipo" value="tiempo-medio" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            ¿Cuál es el tiempo medio de resolución?
                        </button>
                    </form>
                </div>
            </div>

            <!-- Limpiar -->
            @if (Model.Historial.Any())
            {
                <div class="pt-3 border-top d-flex justify-content-end">
                    <form method="post">
                        <input type="hidden" name="tipo" value="limpiar" />
                        <button type="submit" class="btn btn-link text-muted btn-sm p-0" style="font-size:13px">
                            🗑 Limpiar conversación
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    const chat = document.getElementById('chatArea');
    chat.scrollTop = chat.scrollHeight;
</script>
}
