@page
@model Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Panel Administrador";
}

<div class="container mt-4">
    <h2 class="mb-4">Panel Administrador</h2>

    <!-- Tarjetas resumen -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <h3>@Model.TotalIncidencias</h3>
                    <p class="mb-0">Total Incidencias</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h3>@Model.Abiertas</h3>
                    <p class="mb-0">Abiertas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <h3>@Model.EnProceso</h3>
                    <p class="mb-0">En Proceso</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body text-center">
                    <h3>@Model.Cerradas</h3>
                    <p class="mb-0">Cerradas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficas -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Incidencias por Estado</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="chartEstados"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Distribución por Prioridad</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="chartPrioridad"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Incidencias — últimos 7 días</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="chartDias"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficas fila 2: categoría, técnico, usuario -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Incidencias por Categoría</div>
                <div class="card-body">
                    <canvas id="chartCategoria"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Incidencias por Técnico</div>
                <div class="card-body">
                    <canvas id="chartTecnico"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Incidencias por Usuario</div>
                <div class="card-body">
                    <canvas id="chartUsuario"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Tiempo medio de resolución por prioridad</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Prioridad</th><th>SLA máximo</th><th>Tiempo medio real</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (prio, sla, cls) in new[] {
                                ("Critica", 2.0,  "bg-danger"),
                                ("Alta",    8.0,  "bg-warning text-dark"),
                                ("Media",   24.0, "bg-primary"),
                                ("Baja",    72.0, "bg-secondary")
                            })
                            {
                                var horas = Model.TiempoMedioPorPrioridad.TryGetValue(prio, out var v) ? v : null;
                                <tr>
                                    <td><span class="badge @cls">@prio</span></td>
                                    <td class="text-muted">@sla h</td>
                                    <td><strong>@(horas.HasValue ? $"{horas.Value} h" : "—")</strong></td>
                                    <td>
                                        @if (horas.HasValue)
                                        {
                                            if (horas.Value <= sla)
                                            {
                                                <span class="badge bg-success">✓ Dentro del SLA</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">SLA excedido</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin datos</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Acciones rápidas</div>
                <div class="card-body d-flex align-items-center">
                    <div class="row g-3 w-100">
                        <div class="col-6">
                            <a href="/Admin/Usuarios" class="btn btn-outline-dark w-100 py-3">Gestionar Usuarios</a>
                        </div>
                        <div class="col-6">
                            <a href="/Admin/Incidencias" class="btn btn-outline-dark w-100 py-3">Ver Todas las Incidencias</a>
                        </div>
                        <div class="col-6">
                            <a href="/Admin/ExportarExcel" class="btn btn-success w-100 py-3"><i class="bi bi-box-arrow-down me-1"></i>Informe Semanal Excel</a>
                        </div>
                        <div class="col-6">
                            <a href="/Admin/ExportarPdf" class="btn btn-danger w-100 py-3"><i class="bi bi-box-arrow-down me-1"></i>Informe Semanal PDF</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    // Barras: por estado
    new Chart(document.getElementById('chartEstados'), {
        type: 'bar',
        data: {
            labels: ['Abierta', 'En Proceso', 'Resuelta', 'Cerrada'],
            datasets: [{
                label: 'Incidencias',
                data: [@Model.Abiertas, @Model.EnProceso, @Model.Resueltas, @Model.Cerradas],
                backgroundColor: ['#198754','#FFC107','#0DCAF0','#6C757D']
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Donut: por prioridad
    const prioLabels = @Html.Raw(Model.PorPrioridadLabelsJson);
    const prioData   = @Html.Raw(Model.PorPrioridadDataJson);
    const prioColors = prioLabels.map(l =>
        ({'Critica':'#DC3545','Alta':'#FFC107','Media':'#0D6EFD','Baja':'#6C757D'}[l] || '#ADB5BD'));
    new Chart(document.getElementById('chartPrioridad'), {
        type: 'doughnut',
        data: { labels: prioLabels, datasets: [{ data: prioData, backgroundColor: prioColors }] },
        options: { plugins: { legend: { position: 'bottom' } } }
    });

    // Línea: últimos 7 días
    const diasLabels = @Html.Raw(Model.PorDiaLabelsJson);
    const diasData   = @Html.Raw(Model.PorDiaDataJson);
    new Chart(document.getElementById('chartDias'), {
        type: 'line',
        data: {
            labels: diasLabels,
            datasets: [{
                label: 'Creadas',
                data: diasData,
                borderColor: '#0D6EFD',
                backgroundColor: 'rgba(13,110,253,0.1)',
                fill: true,
                tension: 0.3
            }]
        },
        options: { scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });

    // Barras horizontales: por categoría
    const catLabels = @Html.Raw(Model.PorCategoriaLabelsJson);
    const catData   = @Html.Raw(Model.PorCategoriaDataJson);
    new Chart(document.getElementById('chartCategoria'), {
        type: 'bar',
        data: {
            labels: catLabels,
            datasets: [{
                label: 'Incidencias',
                data: catData,
                backgroundColor: ['#0DCAF0','#198754','#FFC107','#DC3545','#6C757D']
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Barras horizontales: por técnico
    const tecLabels = @Html.Raw(Model.PorTecnicoLabelsJson);
    const tecData   = @Html.Raw(Model.PorTecnicoDataJson);
    new Chart(document.getElementById('chartTecnico'), {
        type: 'bar',
        data: {
            labels: tecLabels,
            datasets: [{
                label: 'Incidencias',
                data: tecData,
                backgroundColor: '#0D6EFD'
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Barras horizontales: por usuario
    const usrLabels = @Html.Raw(Model.PorUsuarioLabelsJson);
    const usrData   = @Html.Raw(Model.PorUsuarioDataJson);
    new Chart(document.getElementById('chartUsuario'), {
        type: 'bar',
        data: {
            labels: usrLabels,
            datasets: [{
                label: 'Incidencias',
                data: usrData,
                backgroundColor: '#198754'
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}
