@page
@model Web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Gestión de Incidencias</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #161D35 0%, #0D2050 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow: hidden;
        }

        /* Decorative circles */
        .deco {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
        }
        .deco-1 {
            width: 420px; height: 420px;
            top: -110px; right: -110px;
            background: rgba(255,255,255,0.03);
        }
        .deco-2 {
            width: 320px; height: 320px;
            bottom: -90px; left: -90px;
            background: rgba(13,110,253,0.07);
        }

        /* Login card */
        .login-card {
            position: relative;
            z-index: 1;
            background: white;
            border-radius: 20px;
            padding: 56px 52px;
            width: 520px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.35);
        }

        .login-icon {
            width: 56px; height: 56px;
            background: #0D6EFD;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 30px; font-weight: 900; color: white;
            margin: 0 auto 18px;
        }

        .login-title {
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            color: #161D35;
            margin-bottom: 8px;
        }
        .login-subtitle {
            text-align: center;
            font-size: 14px;
            color: #9AA3B0;
            margin-bottom: 36px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
        }
        .form-control {
            border-radius: 10px;
            border-color: #E5E7EB;
            height: 48px;
            font-size: 15px;
        }
        .form-control:focus {
            border-color: #0D6EFD;
            box-shadow: 0 0 0 3px rgba(13,110,253,.12);
        }

        .btn-login {
            height: 52px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 10px;
            background: #0D6EFD;
            border: none;
            color: white;
            width: 100%;
            margin-top: 12px;
            transition: opacity .15s;
        }
        .btn-login:hover { opacity: .88; color: white; }
        .btn-login:disabled { opacity: .55; }
    </style>
</head>
<body>
    <div class="deco deco-1"></div>
    <div class="deco deco-2"></div>

    <div class="login-card">
        <div class="login-icon">!</div>
        <div class="login-title">Gestión de Incidencias</div>
        <div class="login-subtitle">Accede con tu cuenta</div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger py-2 mb-3" style="font-size:13px">@Model.Error</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control"
                       placeholder="usuario@ejemplo.com" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="Password" class="form-control"
                       placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-login">Iniciar sesión</button>
        </form>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>